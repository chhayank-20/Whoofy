# Dockerfile.render
# Unified image for Next.js (Web) and FastAPI (ML) on Render Free Tier
# Using SQLite instead of PostgreSQL to save memory for YOLO/OCR

# --- Stage 1: Next.js Builder ---
FROM node:20-bookworm-slim AS node_builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .

# Convert Prisma schema to SQLite
RUN chmod +x scripts/convert-prisma-to-sqlite.sh && \
    ./scripts/convert-prisma-to-sqlite.sh prisma/schema.prisma prisma/schema.render.prisma

# Generate Prisma Client and build
ENV DATABASE_URL=file:./dev.db
RUN npx prisma generate --schema prisma/schema.render.prisma
RUN npm run build

# --- Stage 2: Python Dependencies ---
FROM python:3.11-slim-bookworm AS python_deps
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
COPY ml/requirements.txt ./ml/
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --no-cache-dir -r ml/requirements.txt

# --- Stage 3: Final Runner ---
FROM node:20-bookworm-slim AS runner
WORKDIR /app

# Install System Dependencies (Python, FFmpeg, Tesseract, libgl for OpenCV)
# (REMOVED postgresql installation to save RAM)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
    ffmpeg \
    tesseract-ocr \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user and directories
RUN useradd -m -u 10001 whoofy && \
    mkdir -p /app/storage && \
    chown -R whoofy:whoofy /app

# Paths
ENV PATH="/opt/venv/bin:$PATH" 

ENV NODE_ENV=production
ENV HOSTNAME="0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED=1
ENV PYTHONUNBUFFERED=1

USER whoofy

# Copy Next.js Standalone and Static Assets
COPY --from=node_builder --chown=whoofy:whoofy /app/.next/standalone ./
COPY --from=node_builder --chown=whoofy:whoofy /app/.next/static ./.next/static
COPY --from=node_builder --chown=whoofy:whoofy /app/prisma/schema.render.prisma ./prisma/schema.render.prisma

# Copy Python Virtual Environment
COPY --from=python_deps --chown=whoofy:whoofy /opt/venv /opt/venv

# Copy Application Code
COPY --chown=whoofy:whoofy ml ./ml
COPY --chown=whoofy:whoofy yolo ./yolo
COPY --chown=whoofy:whoofy scripts/start-render.sh ./scripts/start-render.sh

RUN chmod +x ./scripts/start-render.sh

# Start both services
CMD ["./scripts/start-render.sh"]
