# Dockerfile.render
# Two-stage build: Node.js builder + Python runtime with Node.js installed
# Uses SQLite to stay within Render Free Tier 512MB RAM limit

# =============================================================================
# Stage 1: Node.js builder — builds Next.js app
# =============================================================================
FROM node:20-bookworm-slim AS node_builder
WORKDIR /app

# Install deps
COPY package*.json ./
RUN npm ci

# Copy all source
COPY . .

# Generate Prisma client for SQLite
ENV DATABASE_URL=file:./dev.db
RUN npx prisma generate --schema prisma/schema.render.prisma

# Patch TypeScript types so build succeeds with SQLite string fields
RUN chmod +x scripts/patch-prisma-types.sh && ./scripts/patch-prisma-types.sh

# Build Next.js in standalone mode
RUN npm run build

# =============================================================================
# Stage 2: Final runtime — Python base + Node.js installed on top
# =============================================================================
FROM python:3.10-slim-bookworm

# Install Node.js 20 and system libraries needed by OpenCV / Tesseract
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gnupg \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    tesseract-ocr \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# --- Python ML dependencies (CPU-only) ---
COPY ml/requirements.txt ./ml/requirements.txt
RUN pip install --no-cache-dir -r ./ml/requirements.txt

# --- Copy ML source ---
COPY ml/ ./ml/

# --- Copy Next.js standalone build output ---
# Next.js standalone mode puts everything needed to run in .next/standalone/
COPY --from=node_builder /app/.next/standalone ./
COPY --from=node_builder /app/.next/static ./.next/static
COPY --from=node_builder /app/public ./public

# --- Copy Prisma schema & scripts needed at runtime ---
COPY --from=node_builder /app/prisma ./prisma
COPY --from=node_builder /app/scripts/start-render.sh ./scripts/start-render.sh
COPY --from=node_builder /app/scripts/flatten-schema.ts ./scripts/flatten-schema.ts
COPY --from=node_builder /app/node_modules ./node_modules

# Make startup script executable and create storage dir
RUN chmod +x ./scripts/start-render.sh && mkdir -p /app/storage

# Environment variables
ENV NODE_ENV=production
ENV PYTHONUNBUFFERED=1
ENV DATABASE_URL=file:/app/storage/whoofy.db
ENV ML_SERVICE_URL=http://localhost:8000
ENV NODE_OPTIONS=--max-old-space-size=350
ENV HOSTNAME=0.0.0.0

EXPOSE 3000

CMD ["./scripts/start-render.sh"]
