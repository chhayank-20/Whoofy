# Dockerfile.render
# Unified image for Next.js (Web) and FastAPI (ML) on Render Free Tier
# Using Debian Bookworm for consistency across Python and Node

# --- Stage 1: Next.js Builder ---
FROM node:20-bookworm-slim AS node_builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npx prisma generate
# Dummy DB for build
ENV DATABASE_URL=postgresql://build:build@localhost:5432/build
RUN npm run build

# --- Stage 2: Python Dependencies ---
FROM python:3.11-slim-bookworm AS python_deps
WORKDIR /app
# Install git because CLIP requires it for installation from GitHub
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
COPY ml/requirements.txt ./ml/
# Use a virtual environment for better isolation and portability
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --no-cache-dir -r ml/requirements.txt

# --- Stage 3: Final Runner ---
FROM node:20-bookworm-slim AS runner
WORKDIR /app

# Install System Dependencies (Python, FFmpeg, Tesseract, libgl for OpenCV, PostgreSQL)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
    ffmpeg \
    tesseract-ocr \
    libgl1 \
    libglib2.0-0 \
    postgresql \
    postgresql-contrib \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user and directories
RUN useradd -m -u 10001 whoofy && \
    mkdir -p /app/storage /app/postgres_data && \
    chown -R whoofy:whoofy /app

# Ensure PostgreSQL bin is in PATH
ENV PATH="/usr/lib/postgresql/15/bin:/opt/venv/bin:$PATH" 

ENV NODE_ENV=production
# REMOVED: ENV PORT=3000 (Let Render provide the PORT variable)
ENV PYTHONUNBUFFERED=1

USER whoofy

# Copy Next.js Standalone and Static Assets
COPY --from=node_builder --chown=whoofy:whoofy /app/.next/standalone ./
COPY --from=node_builder --chown=whoofy:whoofy /app/.next/static ./.next/static

# Copy Python Virtual Environment
COPY --from=python_deps --chown=whoofy:whoofy /opt/venv /opt/venv

# Copy Application Code
COPY --chown=whoofy:whoofy ml ./ml
COPY --chown=whoofy:whoofy yolo ./yolo
COPY --chown=whoofy:whoofy scripts/start-render.sh ./scripts/start-render.sh

RUN chmod +x ./scripts/start-render.sh

# Start both services
CMD ["./scripts/start-render.sh"]
