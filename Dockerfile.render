# Dockerfile.render
# Unified image for Next.js (Web) and FastAPI (ML) on Render Free Tier
# Using SQLite instead of PostgreSQL to save memory for YOLO/OCR

# --- Stage 1: Next.js Builder ---
FROM node:20-bookworm-slim AS node_builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ENV DATABASE_URL=file:./dev.db
RUN npx prisma generate --schema prisma/schema.render.prisma
# Dynamic type patching for SQLite
RUN chmod +x scripts/patch-prisma-types.sh && ./scripts/patch-prisma-types.sh
RUN npm run build

# --- Stage 2: Final Runtime Image ---
FROM python:3.10-slim-bookworm

# Install Node.js 20 & Runtime Deps
RUN apt-get update && apt-get install -y \
    curl \
    gnupg \
    libgl1-mesa-glx \
    libglib2.0-0 \
    tesseract-ocr \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy Next.js Build
COPY --from=node_builder /app/package*.json ./
COPY --from=node_builder /app/.next ./.next
COPY --from=node_builder /app/public ./public
COPY --from=node_builder /app/node_modules ./node_modules
COPY --from=node_builder /app/prisma ./prisma
COPY --from=node_builder /app/scripts ./scripts
COPY --from=node_builder /app/server.js ./server.js

# Install Python ML Deps (CPU Only)
COPY ml/requirements.txt ./ml/
RUN pip install --no-cache-dir -r ml/requirements.txt
COPY ml/ ./ml/

# Create storage directory for SQLite
RUN mkdir -p /app/storage

# Env vars
ENV NODE_ENV=production
ENV DATABASE_URL=file:/app/storage/whoofy.db
ENV ML_SERVICE_URL=http://localhost:8000
ENV PORT=3000
ENV PYTHONUNBUFFERED=1

COPY --from=node_builder /app/.next/standalone ./
COPY --from=node_builder /app/.next/static ./.next/static
COPY --from=node_builder /app/public ./public
COPY --from=node_builder /app/prisma/schema.render.prisma ./prisma/schema.render.prisma

# Copy ML app and packages
COPY --from=python_builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=python_builder /app /app/ml

# Copy scripts
COPY scripts/start-render.sh ./scripts/start-render.sh
COPY scripts/flatten-schema.ts ./scripts/flatten-schema.ts
RUN chmod +x ./scripts/start-render.sh

EXPOSE 3000
CMD ["./scripts/start-render.sh"]
