# Dockerfile.render
# Two-stage build: Node.js builder + Python runtime with Node.js installed
# Uses SQLite to stay within Render Free Tier 512MB RAM limit

# =============================================================================
# Stage 1: Node.js builder — builds Next.js app
# =============================================================================
FROM node:20-bookworm-slim AS node_builder
WORKDIR /app

# Install deps (includes devDeps needed for build: tsx, prisma, etc.)
COPY package*.json ./
RUN npm ci

# Copy all source
COPY . .

# Flatten schema from PostgreSQL → SQLite
RUN npx tsx scripts/flatten-schema.ts prisma/schema.prisma prisma/schema.render.prisma

# Generate Prisma client for SQLite
ENV DATABASE_URL=file:./dev.db
RUN npx prisma generate --schema prisma/schema.render.prisma

# Patch TypeScript types so build succeeds with SQLite string fields
RUN chmod +x scripts/patch-prisma-types.sh && ./scripts/patch-prisma-types.sh

# Build Next.js in standalone mode
# Output: .next/standalone/ (self-contained with its own node_modules)
RUN npm run build

# =============================================================================
# Stage 2: Final runtime — Python base + Node.js installed on top
# =============================================================================
FROM python:3.10-slim-bookworm

# Install Node.js 20 and system libraries needed by OpenCV / Tesseract / CLIP
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gnupg \
    git \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    tesseract-ocr \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# --- Python ML dependencies (CPU-only) ---
COPY ml/requirements.txt ./ml/requirements.txt
RUN pip install --no-cache-dir -r ./ml/requirements.txt

# --- Copy ML source ---
COPY ml/ ./ml/

# --- Copy Next.js standalone build output ---
# .next/standalone/ is a self-contained directory with:
#   - server.js (the Next.js HTTP server)
#   - node_modules/ (trimmed, production-only)
#   - package.json
# We copy it to /app/ so server.js lands at /app/server.js
COPY --from=node_builder /app/.next/standalone /app/
COPY --from=node_builder /app/.next/static /app/.next/static
COPY --from=node_builder /app/public /app/public

# --- Copy Prisma schema (needed for db push at runtime) ---
COPY --from=node_builder /app/prisma /app/prisma

# --- Copy scripts ---
COPY --from=node_builder /app/scripts /app/scripts
RUN chmod +x /app/scripts/start-render.sh

# Create persistent storage dir for SQLite
RUN mkdir -p /app/storage

# Environment variables
ENV NODE_ENV=production
ENV PYTHONUNBUFFERED=1
ENV DATABASE_URL=file:/app/storage/whoofy.db
ENV ML_SERVICE_URL=http://localhost:8000
ENV HOSTNAME=0.0.0.0

EXPOSE 3000

CMD ["/app/scripts/start-render.sh"]
