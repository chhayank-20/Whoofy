# Dockerfile.render
# Unified image for Next.js (Web) and FastAPI (ML) on Render Free Tier
# Using SQLite instead of PostgreSQL to save memory for YOLO/OCR

# --- Stage 1: Next.js Builder ---
FROM node:20-bookworm-slim AS node_builder
WORKDIR /app
COPY package*.json ./
# Add git and tsx for schema processing
RUN apt-get update && apt-get install -y git && npm install -g tsx
RUN npm ci
COPY . .
# 1. Flatten the schema for SQLite
RUN npx tsx scripts/flatten-schema.ts prisma/schema.prisma prisma/schema.render.prisma
# 2. Build Next.js (Standalone)
ENV DATABASE_URL=file:./dev.db
RUN npx prisma generate --schema prisma/schema.render.prisma
RUN npm run build

# --- Stage 2: Python ML Builder ---
FROM python:3.10-slim-bookworm AS python_builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY ml/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY ml/ .

# --- Stage 3: Final Runner (Lean) ---
FROM node:20-bookworm-slim AS runner
WORKDIR /app

# Install only essential runtime libraries for ML (OpenCV/GL/Tesseract)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

# Set ENV for Render
ENV NODE_ENV=production
ENV HOSTNAME="0.0.0.0"
ENV DATABASE_URL="file:/app/storage/whoofy.db"
ENV ML_SERVICE_URL="http://localhost:8000"
ENV NODE_OPTIONS="--max-old-space-size=400"
ENV PYTHONUNBUFFERED=1

# Create app directory and storage
RUN mkdir -p /app/storage

# Copy Next.js Standalone
COPY --from=node_builder /app/.next/standalone ./
COPY --from=node_builder /app/.next/static ./.next/static
COPY --from=node_builder /app/public ./public
COPY --from=node_builder /app/prisma/schema.render.prisma ./prisma/schema.render.prisma

# Copy ML app and packages
COPY --from=python_builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=python_builder /app /app/ml

# Copy scripts
COPY scripts/start-render.sh ./scripts/start-render.sh
COPY scripts/flatten-schema.ts ./scripts/flatten-schema.ts
RUN chmod +x ./scripts/start-render.sh

EXPOSE 3000
CMD ["./scripts/start-render.sh"]
